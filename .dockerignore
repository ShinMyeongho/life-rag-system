# ────────────────────────────────────────────────────────────────
# .dockerignore  –  나의 일기장
#
# Docker 이미지 빌드 시 COPY에서 제외할 파일 목록.
# .gitignore와 겹치지만 목적이 다름:
#   .gitignore   → git 추적 제외 (보안·용량)
#   .dockerignore → 이미지 레이어에서 제외 (보안·빌드 속도)
# ────────────────────────────────────────────────────────────────

# ── 절대 이미지에 포함되면 안 되는 파일 ──────────────────────
# 개인 프로필 (이름, 나이, 건강 정보)
user_config.py

# API 키, DB 비밀번호
.env
.env.*
!.env.docker.example   # 예시 파일은 포함 허용

# ── 개인 데이터 ────────────────────────────────────────────────
# 일기 JSON, 로컬 백업
data/
*.json

# 런타임 로그
logs/

# RAG 원본 문서 (개인 자료)
rag_docs/

# FAISS 인덱스 (빌드 후 볼륨으로 마운트)
faiss_index/

# ── Python 캐시 ────────────────────────────────────────────────
__pycache__/
*.pyc
*.pyo
*.pyd
.Python
*.egg-info/
dist/
build/

# ── 가상환경 ───────────────────────────────────────────────────
venv/
env/
.venv/
.conda/

# ── 개발 도구 ──────────────────────────────────────────────────
.vscode/
.idea/
.git/
.gitignore

# ── Jupyter ────────────────────────────────────────────────────
.ipynb_checkpoints/
*.ipynb

# ── 테스트 캐시 ────────────────────────────────────────────────
.pytest_cache/
.coverage
htmlcov/

# ── OS 파일 ────────────────────────────────────────────────────
.DS_Store
Thumbs.db
desktop.ini

# ── 기타 ───────────────────────────────────────────────────────
*.log
*.tmp
*.bat
.claude/
backups/
